registry=https://registry.npmmirror.com

# 原生模块（better-sqlite3 / @serialport/bindings-cpp）必须在安装阶段按 Electron
# 的 ABI 编译。若被 ignore-scripts 拦掉，它们完全不会构建，打包后表现为
# 「找不到模块」或启动即崩，这是跨平台首次打包最常见的坑。
ignore-scripts=false

# 注意：Electron / electron-builder 的下载镜像故意不写在这里。
# 新版 npm 会对任何非官方 config key 报 "Unknown project config" 警告
# （ELECTRON_MIRROR、npm_config_electron_mirror 都试过，都会告警）。
# 这两个值实际读的是进程环境变量，因此改由 npm scripts 在命令内注入，
# 见 package.json 中的 mirror:* 说明。国内网络慢时执行：
#   macOS / Linux : export ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   Windows (PS)  : $env:ELECTRON_MIRROR='https://npmmirror.com/mirrors/electron/'
